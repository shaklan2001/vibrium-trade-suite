# Vibrium Trade Suite
VIBRIUM_API_BASE_URL=https://api-staging.vibrium.ai
VIBRIUM_AGENTS_API_BASE_URL=https://agents-api.vibrium.ai
VIBRIUM_CUSTOMER_ID=
VIBRIUM_SERVICE_USERNAME=
VIBRIUM_SERVICE_PASSWORD=
VIBRIUM_OPS_COPILOT_BOT_ID=

NEXT_PUBLIC_VIBRIUM_API_URL=https://api-staging.vibrium.ai
NEXT_PUBLIC_VIBRIUM_CUSTOMER_ID=
NEXT_PUBLIC_SITE_NAME=Vibrium Trade
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Worker agents (Phase A–G) — also configurable in Agent Routing UI
NEXT_PUBLIC_AGENT_REQUIREMENT_EXTRACTOR=AA00000025
NEXT_PUBLIC_AGENT_QUOTE_NORMALIZER=AA00000026
NEXT_PUBLIC_AGENT_ARTWORK_CHECKLIST=AA00000027
NEXT_PUBLIC_AGENT_SAMPLE_REQUEST=AA00000028
NEXT_PUBLIC_AGENT_PI_EXTRACTOR=AA00000029
NEXT_PUBLIC_AGENT_PO_EXTRACTOR=AA00000030
NEXT_PUBLIC_AGENT_PI_PO_DISCREPANCY=AA00000031
NEXT_PUBLIC_AGENT_UPC_BARCODE=AA00000032
NEXT_PUBLIC_AGENT_PACKAGING_CHECKLIST=AA00000033
NEXT_PUBLIC_AGENT_INSPECTION=AA00000034
NEXT_PUBLIC_AGENT_PRODUCTION_STATUS=AA00000035
NEXT_PUBLIC_AGENT_BOOKING=AA00000036
NEXT_PUBLIC_AGENT_CBM=AA00000037
NEXT_PUBLIC_AGENT_DOCS_PACK=AA00000038
NEXT_PUBLIC_AGENT_PAYMENT_CLOCK=AA00000039
NEXT_PUBLIC_AGENT_COMMISSION=AA00000040
NEXT_PUBLIC_AGENT_OPS_RISK_SCANNER=AA00000055
NEXT_PUBLIC_AGENT_OPS_PRIORITY_RANKER=AA00000056
NEXT_PUBLIC_AGENT_OPS_DAILY_BRIEF=AA00000057
NEXT_PUBLIC_AGENT_FACTORY_RECOMMENDER=AA00000058
NEXT_PUBLIC_AGENT_DEAL_ECONOMICS=AA00000059
NEXT_PUBLIC_AGENT_FINANCE_PULSE=AA00000060
NEXT_PUBLIC_AGENT_SHIPMENT_PULSE=AA00000061

NEXT_PUBLIC_BOT_OPS_COPILOT=VB00000001
VIBRIUM_OPS_COPILOT_BOT_ID=VB00000001

# Shared deal SoR — Neon fallback (optional when TRADE_SUITE_DB_MODE=rds-proxy).
DATABASE_URL=

# Aurora via VPC Lambda proxy (same pattern as vibrium-backend rds-query-proxy).
# TRADE_SUITE_DB_MODE=rds-proxy → API routes invoke TRADE_SUITE_RDS_PROXY_NAME.
# Lambda itself holds DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD (not the Next app).
TRADE_SUITE_DB_MODE=
TRADE_SUITE_RDS_PROXY_NAME=trade-suite-rds-proxy
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# PST ingest uploads (existing AWS bucket + folder). Uses the local AWS CLI profile.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=conversation-agents-artifacts
AWS_S3_PREFIX=trade/pst-ingest

# Conversational / workflows (assign later)
NEXT_PUBLIC_BOT_FACTORY_OUTREACH=
NEXT_PUBLIC_BOT_BUYER_SELECTION_CHASE=
NEXT_PUBLIC_WF_FACTORY_OUTREACH=
NEXT_PUBLIC_WF_BUYER_SELECTION_CHASE=

# ---------------------------------------------------------------------------
# Team mailboxes (/mailbox/connections) — IMAP to read, SMTP to send.
# See docs/EMAIL_CONNECT.md. Nothing to register with Google or Microsoft.
# ---------------------------------------------------------------------------
# Required: encrypts mailbox passwords at rest. `openssl rand -base64 32`.
# Same value in every environment; changing it means every mailbox re-enters its password.
MAIL_ENCRYPTION_KEY=
# Required: guards /api/mail/cron (Vercel Cron sends it as a Bearer token). `openssl rand -hex 24`
CRON_SECRET=
# Required: only this domain can connect; the server is mail.<domain>, IMAP 993 / SMTP 465.
MAIL_WORKSPACE_DOMAIN=snspl.in
# Monitored inbox shown on /privacy and /terms (default privacy@vibrium.ai).
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=

# Optional mail overrides — the defaults below are already in code, set only to change them:
# MAIL_IMAP_HOST= / MAIL_IMAP_PORT=993 / MAIL_SMTP_HOST= / MAIL_SMTP_PORT=465
# MAIL_DEFAULT_BACKFILL_DAYS=365   MAIL_REQUEST_BUDGET_S=48   MAIL_MESSAGES_PER_RUN=150   MAIL_JOBS_PER_RUN=10
# MAIL_EXTRA_BUYER_DOMAINS= / MAIL_EXTRA_FACTORY_DOMAINS= / MAIL_EXTRA_FORWARDER_DOMAINS= / MAIL_EXTRA_INTERNAL_DOMAINS=
