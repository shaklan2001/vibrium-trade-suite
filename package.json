{
  "name": "vibrium-trade-suite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "provision": "node --env-file=.env.local scripts/provision-phase-a.mjs",
    "provision:upgrade": "node --env-file=.env.local scripts/provision-phase-a.mjs --upgrade",
    "provision:workers": "node --env-file=.env.local scripts/provision-workers.mjs",
    "provision:workers:upgrade": "node --env-file=.env.local scripts/provision-workers.mjs --upgrade",
    "export:specs": "npx tsx -e \"import { writeFileSync } from 'fs'; import { ALL_WORKER_SPECS } from './src/lib/trade/agentSpecs.ts'; writeFileSync('scripts/worker-specs.json', JSON.stringify(ALL_WORKER_SPECS, null, 2));\"",
    "pst:scan": "scripts/pst-extract/.venv/bin/python -u scripts/pst-extract/extract.py --scan-only",
    "pst:extract": "scripts/pst-extract/.venv/bin/python -u scripts/pst-extract/extract.py",
    "pst:repair": "scripts/pst-extract/.venv/bin/python -u scripts/pst-extract/repair_attachments.py",
    "pst:repair:scan": "scripts/pst-extract/.venv/bin/python -u scripts/pst-extract/repair_attachments.py --scan-only",
    "pst:cluster": "scripts/pst-extract/.venv/bin/python -u scripts/pst-extract/cluster_threads.py",
    "pst:relevant": "scripts/pst-extract/.venv/bin/python -u scripts/pst-extract/build_relevant_deals.py",
    "pst:process": "scripts/pst-extract/.venv/bin/python -u scripts/pst-extract/process_deals.py",
    "pst:process:demo": "scripts/pst-extract/.venv/bin/python -u scripts/pst-extract/process_deals.py --with-docs --limit 80",
    "pst:process:full": "scripts/pst-extract/.venv/bin/python -u scripts/pst-extract/process_deals.py",
    "pst:process:dry": "scripts/pst-extract/.venv/bin/python -u scripts/pst-extract/process_deals.py --dry-run --limit 20",
    "db:migrate": "node --env-file=.env.local scripts/migrate-processed-deals.mjs",
    "mail:sync": "node --env-file=.env.local scripts/mail-sync-loop.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@neondatabase/serverless": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "imapflow": "^1.7.8",
    "livekit-client": "^2.23.0",
    "lucide-react": "^1.39.0",
    "mailparser": "^3.14.1",
    "next": "15.5.23",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "topojson-client": "^3.1.0",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/geojson": "^7946.0.16",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
