# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc / OS / editor
.DS_Store
**/.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.pem

# debug
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env*.local
.env.local

# Reference docs, BRDs, supplier form packs, accounting notes, etc.
# Keep docs/samples — required for vault / sample file serving in the app.
/docs/**
!/docs/samples/
!/docs/samples/**

# Cursor / local agent artefacts (if ever present in-repo)
.cursor/
agent-transcripts/

# Turbo
.turbo
