# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc / OS / editor
.DS_Store
**/.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.pem

# debug
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env*.local
.env.local

# Reference docs, BRDs, supplier form packs, accounting notes, etc.
# Keep docs/samples — required for vault / sample file serving in the app.
/docs/**
!/docs/samples/
!/docs/samples/**

# Cursor / local agent artefacts (if ever present in-repo)
.cursor/
agent-transcripts/

# Turbo
.turbo

# ---------------------------------------------------------------------------
# Local mailbox ingest — never publish to git / Vercel (PII + multi-GB)
# ---------------------------------------------------------------------------
/data/
**/pst_extract/
**/new_psts/
**/pst_files/
docs/pst_files/

# Outlook archives and extract dumps
*.pst
*.ost
*.mbox
*.eml
*.msg

# Ingest / agent run artefacts (keep small app JSON like package.json tracked)
*.jsonl
*.sqlite
*.sqlite3
*.db
!scripts/agent-ids.json
!scripts/worker-specs.json
!package.json
!package-lock.json
!tsconfig.json
!vercel.json
!skills-lock.json
!public/**/*.json

# Large local archives / takeouts
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
Archive.zip

# Python venv and caches for PST tooling
scripts/pst-extract/.venv/
scripts/pst-extract/**/__pycache__/
**/__pycache__/
*.pyc
.neon

# Local scratch /tmp dumps sometimes copied into the repo
/tmp/
**/deals.json
**/deals-dump*.json

# Packaged Lambda zip (rebuild via infra/*/deploy.sh)
infra/**/function.zip
