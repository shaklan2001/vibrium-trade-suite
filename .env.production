# Production build values for https://vibrium-trade-suite.vercel.app
# PUBLIC, NON-SECRET values only — this file is committed. Secrets (GOOGLE_CLIENT_SECRET,
# MAIL_ENCRYPTION_KEY, CRON_SECRET, …) stay in Vercel → Settings → Environment Variables.
# Anything set in the Vercel dashboard overrides the values here.
# See docs/GOOGLE_OAUTH_VERIFICATION.md.

# Homepage / privacy / terms URLs and the Gmail OAuth redirect base registered with Google:
#   https://vibrium-trade-suite.vercel.app/api/mail/oauth/google/callback
NEXT_PUBLIC_SITE_URL=https://vibrium-trade-suite.vercel.app

# Google Search Console HTML-tag token (only the content="…" value). Fill in, then redeploy.
# GOOGLE_SITE_VERIFICATION=

# Monitored inbox shown on /privacy and /terms (defaults to privacy@vibrium.ai).
# NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
