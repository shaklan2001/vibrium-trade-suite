# Production build values for https://vibrium-trade-suite.vercel.app
# PUBLIC, NON-SECRET values only — this file is committed. Secrets (MAIL_ENCRYPTION_KEY,
# CRON_SECRET, AWS keys, …) stay in Vercel → Settings → Environment Variables.
# Anything set in the Vercel dashboard overrides the values here.

# Homepage / privacy / terms links.
NEXT_PUBLIC_SITE_URL=https://vibrium-trade-suite.vercel.app

# Monitored inbox shown on /privacy and /terms (defaults to privacy@vibrium.ai).
# NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=

# SNSPL team mailboxes: only @snspl.in can connect; server = mail.snspl.in (IMAP 993 / SMTP 465).
MAIL_WORKSPACE_DOMAIN=snspl.in
